# Groq OpenAI-compatible chat completions configuration.
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# Sarvam REST API configuration.
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
SARVAM_LOG_RESPONSES=false
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_LANGUAGE_CODE=hi-IN

# Local transport configuration.
HOST=127.0.0.1
PORT=8787
ALLOWED_ORIGINS=*

# Set to true only for offline deterministic adapter tests.
PROTOTYPE_MODE=false
